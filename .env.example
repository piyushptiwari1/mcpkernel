# ─── MCPKernel configuration ──────────────────────────────────────────────────
# All settings can also be expressed in a YAML config file (pass via --config).
# Environment values are nested with ``__`` between section and field, e.g.
# ``proxy.port`` becomes ``MCPKERNEL_PROXY__PORT``.
#
# Copy this file to .env and edit. Never commit the resulting .env.

# ─── Proxy ────────────────────────────────────────────────────────────────────
MCPKERNEL_PROXY__HOST=127.0.0.1
MCPKERNEL_PROXY__PORT=8080
MCPKERNEL_PROXY__WORKERS=1
# Comma-separated list. Leave blank to disable CORS.
MCPKERNEL_PROXY__CORS_ORIGINS=
MCPKERNEL_PROXY__MAX_REQUEST_SIZE_BYTES=10485760

# ─── Authentication ───────────────────────────────────────────────────────────
# ``api_key``, ``oauth2``, ``mtls``, or ``none``.
MCPKERNEL_AUTH__METHOD=none
# Static API keys (only used when method=api_key). Comma-separated.
MCPKERNEL_AUTH__API_KEYS=
# OAuth2 / JWT (method=oauth2)
MCPKERNEL_AUTH__JWKS_URL=
MCPKERNEL_AUTH__ISSUER=
MCPKERNEL_AUTH__AUDIENCE=
# RFC 8707 — canonical resource URI for this MCP server. MCP 2025-11-25 §Authorization
# requires this for every issued token.
MCPKERNEL_AUTH__RESOURCE=
# Hard-fail tokens whose ``aud`` claim does not name AUTH__RESOURCE (recommended: true)
MCPKERNEL_AUTH__REQUIRE_RESOURCE=false

# ─── Rate limiting ────────────────────────────────────────────────────────────
MCPKERNEL_RATE_LIMIT__ENABLED=true
MCPKERNEL_RATE_LIMIT__REQUESTS_PER_MINUTE=60
MCPKERNEL_RATE_LIMIT__BURST_SIZE=10

# ─── Sandbox (tool execution isolation) ───────────────────────────────────────
# ``docker``, ``firecracker``, ``wasm``, ``microsandbox``, or ``none``.
MCPKERNEL_SANDBOX__BACKEND=docker
MCPKERNEL_SANDBOX__DEFAULT_TIMEOUT_SECONDS=30
MCPKERNEL_SANDBOX__MAX_CPU_CORES=1.0
MCPKERNEL_SANDBOX__MAX_MEMORY_MB=256
MCPKERNEL_SANDBOX__MAX_DISK_MB=512
# Comma-separated egress allowlist. Blank = deny all egress.
MCPKERNEL_SANDBOX__ALLOWED_EGRESS_DOMAINS=
# Used by the docker backend.
DOCKER_HOST=unix:///var/run/docker.sock

# ─── DEE (Deterministic Execution Envelopes) ──────────────────────────────────
MCPKERNEL_DEE__ENABLED=true
MCPKERNEL_DEE__STORE_PATH=./dee_store
# Sign envelopes with Sigstore (requires SIGSTORE_ID_TOKEN below or ambient OIDC).
MCPKERNEL_DEE__SIGN=false
# Workload-identity OIDC token (e.g. set by GitHub Actions).
# Leave blank in non-CI environments — Sigstore will use interactive OAuth.
SIGSTORE_ID_TOKEN=

# ─── Taint tracking ───────────────────────────────────────────────────────────
# ``full``, ``light``, or ``off``.
MCPKERNEL_TAINT__MODE=full
MCPKERNEL_TAINT__BLOCK_ON_VIOLATION=true

# ─── Policy engine ────────────────────────────────────────────────────────────
# Comma-separated YAML files; relative paths resolved from CWD.
MCPKERNEL_POLICY__POLICY_PATHS=policies/owasp_asi_2026_strict.yaml
# Hot-reload policies when files change on disk (requires watchdog).
MCPKERNEL_POLICY__HOT_RELOAD=false

# ─── Observability ────────────────────────────────────────────────────────────
MCPKERNEL_OBSERVABILITY__METRICS_ENABLED=true
MCPKERNEL_OBSERVABILITY__METRICS_PORT=9090
MCPKERNEL_OBSERVABILITY__TRACING_ENABLED=false
# Defaults to "http://localhost:4317" when tracing is on.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=mcpkernel

# ─── Audit ────────────────────────────────────────────────────────────────────
MCPKERNEL_AUDIT__ENABLED=true
MCPKERNEL_AUDIT__DB_PATH=./audit.db
# Token gating ``/health/secret`` and other privileged ops. Required when
# proxy is exposed beyond loopback.
MCPKERNEL_HEALTH_TOKEN=

# ─── Secrets backend (env|vault|aws|gcp) ──────────────────────────────────────
# When set to anything other than ``env``, the indicated provider is queried
# for any setting whose value starts with ``secret://<name>``.
MCPKERNEL_SECRETS_BACKEND=env
# HashiCorp Vault (when backend=vault)
VAULT_ADDR=
VAULT_TOKEN=
VAULT_NAMESPACE=
# AWS (when backend=aws) — uses standard AWS SDK env vars
AWS_REGION=
# GCP (when backend=gcp)
GOOGLE_CLOUD_PROJECT=

# ─── Third-party integrations (optional) ──────────────────────────────────────
# Langfuse — LLM call tracing
MCPKERNEL_LANGFUSE__ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Guardrails AI
MCPKERNEL_GUARDRAILS_AI__ENABLED=false
